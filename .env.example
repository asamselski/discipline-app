# Skopiuj ten plik jako .env.local przed `npm run deploy`.
# Wartości VITE_* są publiczną konfiguracją aplikacji przeglądarkowej,
# dlatego klucz API musi mieć ograniczenia ustawione w Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=TWÓJ_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=TWÓJ_KLUCZ_API
